FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HUB_DISABLE_TELEMETRY=1

WORKDIR /app

RUN useradd --create-home --uid 10001 inspirerank

COPY apps/api /app/apps/api

RUN python -m pip install --upgrade pip \
    && python -m pip install \
       --index-url https://download.pytorch.org/whl/cpu \
       "torch>=2.5" \
    && python -m pip install \
       "/app/apps/api[ml,production]"

RUN mkdir -p /var/cache/huggingface \
    && chown -R inspirerank:inspirerank /var/cache/huggingface /app

USER inspirerank

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--app-dir", "apps/api", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips=*"]
